# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Ollama doesn't need a real key — set a placeholder
OLLAMA_API_KEY=local

# ── Provider Override ─────────────────────────────────────────────────────────
# Overrides active_provider in config.json
# AGENTFLOW_PROVIDER=openai

# ── Workspace ─────────────────────────────────────────────────────────────────
# AGENTFLOW_WORKSPACE=/path/to/custom/workspace

# ── Debug ─────────────────────────────────────────────────────────────────────
# AGENTFLOW_VERBOSE=true
